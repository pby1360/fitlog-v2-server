# prod 프로파일 필수 환경변수 템플릿
# 사용법: 이 파일을 .env.local 로 복사한 뒤 실제 값을 채운다
#   cp .env.example .env.local
# .env.local 은 .gitignore / .dockerignore 양쪽에서 차단됨 (이 파일만 커밋 대상)

# --- DB (Supabase 트랜잭션 풀러 6543) ---
# 포트 5432(직결) 아닌 6543(풀러) + prepareThreshold=0 필수
SPRING_DATASOURCE_URL=jdbc:postgresql://<supabase-host>.pooler.supabase.com:6543/postgres?prepareThreshold=0
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- JWT ---
# HS256 기준 최소 32바이트. 짧으면 기동 시 WeakKeyException
JWT_SECRET=

# --- 앱 ---
# 로컬 컨테이너 테스트용. Cloud Run 배포 시엔 Firebase Hosting 도메인으로 교체
FRONTEND_URL=http://localhost:3000

# --- 선택 (기본값 있음, 미지정 가능) ---
# ACCESS_TOKEN_EXPIRY=3600
# REFRESH_TOKEN_EXPIRY=604800
# PORT=8080
