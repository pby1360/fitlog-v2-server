      "tagPrefixes": ["recovery-"],
      "packageNamePrefixes": ["fitlog-server"]
    }
  },
  {
    "name": "keep-recent-versions",
    "action": { "type": "Keep" },
    "mostRecentVersions": {
      "keepCount": 6
    }
  },
  {
    "name": "delete-old-versions",
    "action": { "type": "Delete" },
    "condition": {
      "olderThan": "14d"
    }
  }
